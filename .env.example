# Copy to .env (local) or set these in your host's env (Vercel/Railway).
# .env is gitignored — never commit real secrets.

# --- Database ---
# Local dev: a local SQLite file.
DATABASE_URL="file:./dev.db"
# Production (Turso / libSQL): set these and they take precedence over DATABASE_URL.
# Get them from `turso db show <name>` and `turso db tokens create <name>`.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- Auth ---
# REQUIRED in production: 32+ char random secret (the app refuses to boot without it).
# Generate: openssl rand -base64 48
AUTH_SECRET="dev-only-change-me-please-32chars-min-secret-0001"
SESSION_TTL_SECONDS="604800"

# --- App ---
# Public base URL — used to build email verification links. Set to your real domain in prod.
APP_URL="http://localhost:3000"
APP_NAME="場邊 Courtside"

# --- Email ---
# "console" (dev: prints + writes to .mail/), "resend" (recommended in prod), or "smtp".
EMAIL_PROVIDER="console"
# From address. With Resend, use onboarding@resend.dev for testing, or an address
# on a domain you've verified in Resend (e.g. no-reply@yourdomain.com).
EMAIL_FROM="場邊 Courtside <onboarding@resend.dev>"
# EMAIL_PROVIDER=resend → set this (https://resend.com/api-keys):
RESEND_API_KEY=""
# EMAIL_PROVIDER=smtp → set these instead:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Seed (super admin created by prisma/seed.ts) ---
SEED_SUPERADMIN_USERNAME="superadmin"
SEED_SUPERADMIN_EMAIL="you@example.com"
SEED_SUPERADMIN_PASSWORD="change-me-strong-password"

# --- Transcripts & translation (YouTube videos) ---
# Translation to zh-TW. Without a provider, captions still work and the page
# shows "翻譯服務未設定". Keys are server-side only.
# Option A — NVIDIA NIM (free developer key from https://build.nvidia.com,
# rate-limited ~40 req/min, intended for development/evaluation):
NVIDIA_API_KEY=""
# TRANSCRIPT_TRANSLATE_MODEL="z-ai/glm-5.3-flash"   # default; faster but less accurate: minimaxai/minimax-m3.1-flash
# TRANSCRIPT_TRANSLATE_REASONING_EFFORT="low"        # OpenAI-compatible only; "" to omit
# Option B — Claude:
# ANTHROPIC_API_KEY=""
# TRANSCRIPT_TRANSLATE_MODEL="claude-opus-5-5"
# TRANSCRIPT_TRANSLATE_EFFORT="low"
# Option C — any OpenAI-compatible endpoint (Groq, OpenRouter, self-hosted NIM, Ollama…):
# TRANSCRIPT_TRANSLATE_PROVIDER="openai"
# TRANSCRIPT_TRANSLATE_BASE_URL="http://localhost:11434/v1"
# TRANSCRIPT_TRANSLATE_MODEL="qwen3"
# TRANSCRIPT_TRANSLATE_API_KEY=""
# If several keys are set, pick one explicitly: nim | anthropic | openai
# TRANSCRIPT_TRANSLATE_PROVIDER="nim"
# YouTube blocks requests from cloud/datacenter IPs (Vercel, AWS…) with "Sign in
# to confirm you're not a bot". In production, route YouTube traffic through a
# (residential) proxy; leave empty for local dev on a home connection.
# YOUTUBE_PROXY_URL="http://user:pass@proxy.example.com:8080"
# …or a signed-in YouTube session (USE A DEDICATED GOOGLE ACCOUNT — it may get
# limited). The bot wall is then retried as a signed-in TV client. Value: the
# `cookie` request header copied from DevTools on youtube.com (one line), or a
# cookies.txt export. Export from a private window and close it without logging
# out, so the browser doesn't rotate the session. Check: npx tsx scripts/youtube-cookie-check.ts
# YOUTUBE_COOKIES=""
# Speech recognition for videos without suitable captions. Needs a host that can
# run Python (not Vercel serverless): pip install -r scripts/asr/requirements.txt
# TRANSCRIPT_ASR_COMMAND="python3 scripts/asr/transcribe.py"
# TRANSCRIPT_ASR_TIMEOUT_MS="1800000"
